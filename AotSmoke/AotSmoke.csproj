<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>JT808 协议 AOT 冒烟</AssemblyTitle>
    <Description>NativeAOT 兼容冒烟：帧编解码、消息工厂、全部消息体往返、TLV/KLV、多语言与 JSON 序列化，任一失败以非 0 退出码反馈</Description>
    <Deterministic>false</Deterministic>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Newlife.JT808\NewLife.JT808.csproj" />
  </ItemGroup>

  <!-- 消息工厂通过反射扫描全部消息体，AOT/裁剪下需保留协议库类型 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="NewLife.JT808" />
  </ItemGroup>

</Project>
