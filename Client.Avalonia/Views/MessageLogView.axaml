<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Client.Avalonia.Converters"
             x:Class="Client.Avalonia.Views.MessageLogView">
  <UserControl.Resources>
    <c:DirectionToColorConverter x:Key="DirToColor" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*,Auto" Margin="10">
    <!-- 标题栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <Label FontSize="18" FontWeight="Bold">消息日志</Label>
      <Button Content="清空" Command="{Binding ClearCommand}" HorizontalAlignment="Right" />
    </StackPanel>

    <!-- 消息列表 -->
    <ListBox Grid.Row="1"
             ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="60,30,80,80,50,*,Auto">
            <Label Grid.Column="0" Content="{Binding Time, StringFormat={}{0:HH:mm:ss}}" FontSize="12" />
            <Label Grid.Column="1" Content="{Binding Direction}" FontSize="14" FontWeight="Bold"
                   Foreground="{Binding Direction, Converter={StaticResource DirToColor}}" />
            <Label Grid.Column="2" Content="{Binding KindName}" FontSize="12" />
            <Label Grid.Column="3" Content="{Binding Mobile}" FontSize="12" />
            <Label Grid.Column="4" Content="{Binding Sequence}" FontSize="12" />
            <Label Grid.Column="5" Content="{Binding Length, StringFormat={}{0} 字节}" FontSize="12" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 详情面板 -->
    <Expander Grid.Row="2" Header="消息详情" IsExpanded="False">
      <TabControl>
        <TabItem Header="JSON">
          <ScrollViewer>
            <TextBlock Text="{Binding SelectedEntry.JsonBody}"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Hex">
          <ScrollViewer>
            <TextBlock Text="{Binding SelectedEntry.HexDump}"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Expander>
  </Grid>
</UserControl>
