<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Client.Avalonia.Converters"
             x:Class="Client.Avalonia.Views.MessageLogView">
  <UserControl.Resources>
    <c:DirectionToColorConverter x:Key="DirToColor" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*,Auto" Margin="10">
    <!-- 标题栏 -->
    <Border Grid.Row="0" Padding="0,0,0,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Label FontSize="16" FontWeight="Bold" VerticalAlignment="Center">📋 消息日志</Label>
        </StackPanel>
        <Button Grid.Column="2" Content="清空" Command="{Binding ClearCommand}"
                FontSize="12" Padding="12,4" />
      </Grid>
    </Border>

    <!-- 消息列表 -->
    <ListBox Grid.Row="1"
             ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry}"
             BorderThickness="1"
             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem:nth-child(even)">
          <Setter Property="Background" Value="#0D000000" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
          <Setter Property="Background" Value="#1A000000" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="60,32,90,90,50,*,Auto">
            <Label Grid.Column="0" Content="{Binding Time, StringFormat={}{0:HH:mm:ss}}" FontSize="11" />
            <Label Grid.Column="1" Content="{Binding Direction}" FontSize="13" FontWeight="Bold"
                   Foreground="{Binding Direction, Converter={StaticResource DirToColor}}" />
            <Label Grid.Column="2" Content="{Binding KindName}" FontSize="11" />
            <Label Grid.Column="3" Content="{Binding Mobile}" FontSize="11" Foreground="#666" />
            <Label Grid.Column="4" Content="{Binding Sequence}" FontSize="11" Foreground="#666" />
            <Label Grid.Column="5" Content="{Binding Length, StringFormat={}{0} 字节}" FontSize="11" Foreground="#888" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 详情面板 -->
    <Expander Grid.Row="2" Header="📄 消息详情" IsExpanded="False"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="4">
      <TabControl Margin="0,6,0,0">
        <TabItem Header="JSON">
          <ScrollViewer>
            <TextBlock Text="{Binding SelectedEntry.JsonBody}"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="6" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Hex">
          <ScrollViewer>
            <TextBlock Text="{Binding SelectedEntry.HexDump}"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="6" />
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Expander>
  </Grid>
</UserControl>
