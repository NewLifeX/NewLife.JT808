<?xml version="1.0" encoding="utf-8"?>
<EntityModel xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:schemaLocation="https://newlifex.com https://newlifex.com/Model202509.xsd" ModelVersion="2.0.2026.130" Document="https://newlifex.com/xcode/model" xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <!--类名模板。其中{name}替换为Table.Name，如{name}Model/I{name}Dto等-->
    <ClassNameTemplate />
    <!--显示名模板。其中{displayName}替换为Table.DisplayName-->
    <DisplayNameTemplate />
    <!--基类。可能包含基类和接口，其中{name}替换为Table.Name-->
    <BaseClass>Entity</BaseClass>
    <!--命名空间-->
    <Namespace>JT808.Data.Platform</Namespace>
    <!--引用命名空间-->
    <ExtendNameSpace />
    <!--输出目录-->
    <Output>..\Platform\</Output>
    <!--是否使用中文文件名。默认false-->
    <ChineseFileName>True</ChineseFileName>
    <!--用于生成Copy函数的参数类型。例如{name}或I{name}-->
    <ModelNameForCopy />
    <!--带有索引器。实现IModel接口-->
    <HasIModel>True</HasIModel>
    <!--可为null上下文。生成String?等-->
    <Nullable>True</Nullable>
    <!--数据库连接名-->
    <ConnName>Platform</ConnName>
    <!--模型类模版。设置后生成模型类，用于接口数据传输，例如{name}Model-->
    <ModelClass>{name}Model</ModelClass>
    <!--模型类输出目录。默认当前目录的Models子目录-->
    <ModelsOutput>..\Platform\Models\</ModelsOutput>
    <!--模型接口模版。设置后生成模型接口，用于约束模型类和实体类，例如I{name}-->
    <ModelInterface>I{name}</ModelInterface>
    <!--模型接口输出目录。默认当前目录的Interfaces子目录-->
    <InterfacesOutput>..\Platform\Interfaces\</InterfacesOutput>
    <!--用户实体转为模型类的模型类。例如{name}或{name}DTO-->
    <ModelNameForToModel />
    <!--命名格式。Default/Upper/Lower/Underline-->
    <NameFormat>Default</NameFormat>
    <!--魔方区域显示名-->
    <DisplayName>平台管理</DisplayName>
    <!--魔方控制器输出目录-->
    <CubeOutput>..\..\JT808.Web\Areas\Platform</CubeOutput>
  </Option>
  <Tables>
    <Table Name="ForwardServer" Description="转发服务。数据转发目标配置">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Name" DataType="String" Master="True" Nullable="False" Description="名称" />
        <Column Name="Server" DataType="String" Length="200" Description="服务地址" />
        <Column Name="Port" DataType="Int32" Description="端口" />
        <Column Name="Protocol" DataType="String" Length="20" Description="协议。TCP/RocketMQ/Redis" />
        <Column Name="Topic" DataType="String" Length="100" Description="主题" />
        <Column Name="Enable" DataType="Boolean" DefaultValue="True" Description="启用" />
        <Column Name="CreateTime" DataType="DateTime" DefaultValue="getdate()" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" DefaultValue="getdate()" Description="更新时间" />
      </Columns>
    </Table>
    <Table Name="MediaServer" Description="流媒体服务。音视频流媒体服务节点">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Name" DataType="String" Master="True" Nullable="False" Description="名称" />
        <Column Name="Server" DataType="String" Length="200" Description="服务地址" />
        <Column Name="Port" DataType="Int32" Description="端口" />
        <Column Name="Enable" DataType="Boolean" DefaultValue="True" Description="启用" />
        <Column Name="CreateTime" DataType="DateTime" DefaultValue="getdate()" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" DefaultValue="getdate()" Description="更新时间" />
      </Columns>
    </Table>
    <Table Name="SuperviseServer" Description="监管服务。JT809监管平台对接配置">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Name" DataType="String" Master="True" Nullable="False" Description="名称" />
        <Column Name="Server" DataType="String" Length="200" Description="主服务地址" />
        <Column Name="BackupServer" DataType="String" Length="200" Description="备服务地址" />
        <Column Name="Port" DataType="Int32" Description="端口" />
        <Column Name="Province" DataType="String" Length="20" Description="省域" />
        <Column Name="Enable" DataType="Boolean" DefaultValue="True" Description="启用" />
        <Column Name="CreateTime" DataType="DateTime" DefaultValue="getdate()" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" DefaultValue="getdate()" Description="更新时间" />
      </Columns>
    </Table>
    <Table Name="SuperviseOnline" Description="监管在线。监管平台在线状态">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="ServerId" DataType="Int32" Description="监管服务编号" />
        <Column Name="Online" DataType="Boolean" Description="在线状态" />
        <Column Name="HeartbeatTime" DataType="DateTime" Description="最后心跳时间" />
        <Column Name="CreateTime" DataType="DateTime" DefaultValue="getdate()" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" DefaultValue="getdate()" Description="更新时间" />
      </Columns>
      <Indexes>
        <Index Columns="ServerId" Unique="True" />
      </Indexes>
    </Table>
    <Table Name="CarList" Description="车辆清单。平台接入车辆白名单">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Mobile" DataType="String" Master="True" Length="20" Nullable="False" Description="手机号" />
        <Column Name="PlateNo" DataType="String" Length="20" Description="车牌号" />
        <Column Name="PlateColor" DataType="Int32" Description="车牌颜色" />
        <Column Name="Enable" DataType="Boolean" DefaultValue="True" Description="启用" />
        <Column Name="CreateTime" DataType="DateTime" DefaultValue="getdate()" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" DefaultValue="getdate()" Description="更新时间" />
      </Columns>
      <Indexes>
        <Index Columns="Mobile" Unique="True" />
      </Indexes>
    </Table>
    <Table Name="SimCard" Description="物联网卡。SIM卡信息管理">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Mobile" DataType="String" Master="True" Length="20" Nullable="False" Description="手机号" />
        <Column Name="Operator" DataType="String" Length="20" Description="运营商" />
        <Column Name="Enable" DataType="Boolean" DefaultValue="True" Description="启用" />
        <Column Name="ExpireTime" DataType="DateTime" Description="到期时间" />
        <Column Name="CreateTime" DataType="DateTime" DefaultValue="getdate()" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" DefaultValue="getdate()" Description="更新时间" />
      </Columns>
      <Indexes>
        <Index Columns="Mobile" Unique="True" />
      </Indexes>
    </Table>
  </Tables>
</EntityModel>