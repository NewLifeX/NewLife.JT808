        <Column Name="DeviceId" DataType="Int32" Description="设备编号" />
        <Column Name="Mobile" DataType="String" Length="20" Description="手机号" />
        <Column Name="EventId" DataType="Int64" Description="报警事件编号" />
        <Column Name="FileType" DataType="String" Length="20" Description="文件类型。image/video/audio" />
        <Column Name="FileName" DataType="String" Length="200" Description="文件名" />
