      </Columns>
      <Indexes>
        <Index Columns="DeviceId,EventId" />
      </Indexes>
    </Table>
    <Table Name="MediaResource" Description="媒体资源。主动安全多媒体资源索引">
      <Columns>
        <Column Name="Id" DataType="Int64" PrimaryKey="True" DataScale="time" Description="编号" />
        <Column Name="DeviceId" DataType="Int32" Description="设备编号" />
        <Column Name="Mobile" DataType="String" Length="20" Description="手机号" />
