<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
		<RootNamespace>NewLife.JT808</RootNamespace>
		<AssemblyTitle>JT808 Protocol Library</AssemblyTitle>
		<Description>Complete implementation of the JT/T 808 vehicle positioning protocol, covering the 2011, 2013 and 2019 versions.</Description>
		<Company>新生命开发团队</Company>
		<Copyright>©2002-2026 新生命开发团队</Copyright>
		<VersionPrefix>1.1</VersionPrefix>
		<VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
		<Deterministic>false</Deterministic>
		<OutputPath>..\Bin</OutputPath>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>$(AssemblyName)</PackageId>
		<Authors>$(Company)</Authors>
		<PackageDescription>Complete implementation of the JT/T 808 vehicle positioning protocol, covering the 2011, 2013 and 2019 versions. JT/T 808 车辆定位协议完整实现，支持 2011、2013 与 2019 版本；内置粤标/苏标扩展、JT/T 1078 音视频与行车记录仪数据包，原生 AOT 就绪并内置 11 种语言运行时消息。</PackageDescription>
		<PackageProjectUrl>https://newlifex.com</PackageProjectUrl>
		<PackageIcon>leaf.png</PackageIcon>
		<RepositoryUrl>https://github.com/NewLifeX/NewLife.JT808</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>物联网;IoT;车联网;GPS;北斗;JT808;JT/T808;新生命团队;NewLife;$(AssemblyName)</PackageTags>
		<PackageReleaseNotes>新增 0x0201 位置查询应答与围栏/路线消息行标字节编解码；集群共享状态改为 Redis 承载在线会话/节点心跳/黑名单；消息队列接入 IMessageBus 并支持外部 RocketMQ/Kafka；新增 net8.0 目标与 NativeAOT 支持（AotSmoke 16 场景）；11 种语言运行时本地化与程序集元数据本地化；修复 KLV 截断、TLV 越界、分包序号、T0801/T8401/T1FC4 编解码等缺陷；172/172 测试用例通过</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.nuget.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0' Or '$(TargetFramework)'=='netstandard2.1'">
		<PackageReference Include="System.Text.Encoding.CodePages" Version="5.0.0" />
	</ItemGroup>

	<!-- 非 Windows 构建机（CI 的 Linux/macOS）编译 net4x 目标需要引用程序集 -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
	</ItemGroup>

	<!-- 发布包支持 NativeAOT：net8.0+ 才启用 AOT/裁剪分析器，旧目标框架保持原样 -->
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.nuget.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
