<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
		<RootNamespace>NewLife.JT808</RootNamespace>
		<AssemblyTitle>JT808 Protocol Library</AssemblyTitle>
		<Description>Complete implementation of the JT/T 808 vehicle positioning protocol, covering the 2011, 2013 and 2019 versions.</Description>
		<Company>新生命开发团队</Company>
		<Copyright>©2002-2026 新生命开发团队</Copyright>
		<VersionPrefix>1.1</VersionPrefix>
		<VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
		<Deterministic>false</Deterministic>
		<OutputPath>..\Bin</OutputPath>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>$(AssemblyName)</PackageId>
		<Authors>$(Company)</Authors>
		<PackageDescription>Complete implementation of the JT/T 808 vehicle positioning protocol, covering the 2011, 2013 and 2019 versions. JT/T 808 车辆定位协议完整实现，支持 2011、2013 与 2019 版本；内置粤标/苏标扩展、JT/T 1078 音视频与行车记录仪数据包，原生 AOT 就绪并内置 11 种语言运行时消息。</PackageDescription>
		<PackageProjectUrl>https://newlifex.com</PackageProjectUrl>
		<PackageIcon>leaf.png</PackageIcon>
		<RepositoryUrl>https://github.com/NewLifeX/NewLife.JT808</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>物联网;IoT;车联网;GPS;北斗;JT808;JT/T808;新生命团队;NewLife;$(AssemblyName)</PackageTags>
		<PackageReleaseNotes>新增 Web API 管理接口（统一下发指令/会话管理/黑名单/Token 鉴权）；新增消息队列抽象接口与默认内存实现；新增跨服务器指令下发（Stardust 事件总线）；新增客户端自动重连与心跳管理；重组协议类结构（提取 Interfaces/Attributes/Enums 子目录）；39/39 测试全部通过</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.nuget.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0' Or '$(TargetFramework)'=='netstandard2.1'">
		<PackageReference Include="System.Text.Encoding.CodePages" Version="5.0.0" />
	</ItemGroup>

	<!-- 非 Windows 构建机（CI 的 Linux/macOS）编译 net4x 目标需要引用程序集 -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NewLife.Core" Version="12.0.2026.1021-beta0321" />
	</ItemGroup>

	<!-- 发布包支持 NativeAOT：net8.0+ 才启用 AOT/裁剪分析器，旧目标框架保持原样 -->
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.nuget.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
